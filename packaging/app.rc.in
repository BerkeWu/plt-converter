// Windows resource for plt_gui.exe: taskbar/desktop/Explorer icon + version info (Explorer "Details" tab,
// Inno Setup reads ProductName for the uninstall entry). Generated from app.rc.in by CMake (configure_file),
// which bakes in the actual version numbers and an absolute path to icon.ico -- nothing to keep in sync by hand.
#include <winresrc.h>

IDI_ICON1 ICON "@PLT_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "好样纸样"
            VALUE "FileDescription", "好样格式转换"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "plt_gui"
            VALUE "OriginalFilename", "plt_gui.exe"
            VALUE "ProductName", "好样格式转换"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
